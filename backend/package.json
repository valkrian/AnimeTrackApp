{
  "name": "anime-tracker-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start:dev": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "python -m py_compile app/main.py && echo 'FastAPI backend validated'",
    "install": "pip install -r requirements.txt",
    "lint": "flake8 app/",
    "format": "black app/"
  },
  "dependencies": {},
  "devDependencies": {}
}
